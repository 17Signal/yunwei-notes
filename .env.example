# Keep localhost here for host-side scripts; Docker Compose overrides the app container to use `db`.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/notes_selfhosted?schema=public"
SESSION_SECRET="replace-with-32+chars-random-string"
APP_PASSWORD_HASH="\$2b\$12\$replace_with_bcrypt_hash"
UPLOAD_DIR="./data/uploads"
MAX_UPLOAD_SIZE_MB="10"
NEXT_PUBLIC_DISPLAY_TIMEZONE="Asia/Shanghai"
# Set true when serving through HTTPS. Compose defaults to false for local HTTP.
# COOKIE_SECURE="true"
# APP_BIND_ADDRESS="127.0.0.1"
